  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^20.0.0",
    "typescript": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "p-retry": "^7.1.1"
  },
  "engines": {
    "node": ">=20.3.0"
