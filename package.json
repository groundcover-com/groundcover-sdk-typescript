{
  "name": "@groundcover/sdk",
  "version": "0.1.0",
  "description": "groundcover TypeScript SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
